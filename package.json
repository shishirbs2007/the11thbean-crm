{
  "name": "the11thbean-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bootstrap:local": "bash ./the11thbean-full-build.sh",
    "bootstrap:staging": "bash ./scripts/bootstrap-staging.sh",
    "reset:local": "bash ./scripts/reset-local.sh",
    "validate": "bash ./scripts/validate-all.sh",
    "lint": "eslint src tests vitest.config.ts playwright.shared.ts playwright.production.config.ts playwright.staging.config.ts playwright.local.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:guards": "bash ./tests/guards/environment-guard.test.sh",
    "test:e2e:local": "bash ./scripts/test-local-e2e.sh",
    "test:e2e:staging": "bash ./scripts/test-staging-e2e.sh",
    "test:public": "playwright test --config=playwright.production.config.ts --project=public",
    "test:auth:smoke": "playwright test --config=playwright.production.config.ts --project=auth-smoke",
    "test:smoke": "playwright test --config=playwright.production.config.ts",
    "test:report": "playwright show-report",
    "verify:staging": "bash ./scripts/verify-staging.sh",
    "petpooja:setup": "cp -n services/petpooja-bridge/.env.example services/petpooja-bridge/.env 2>/dev/null || true",
    "petpooja:probe": "node --env-file-if-exists=services/petpooja-bridge/.env --experimental-strip-types services/petpooja-bridge/src/probe.ts",
    "petpooja:orders": "node --env-file-if-exists=services/petpooja-bridge/.env --experimental-strip-types services/petpooja-bridge/src/orders-cli.ts",
    "petpooja:bridge": "node --env-file-if-exists=services/petpooja-bridge/.env --experimental-strip-types services/petpooja-bridge/src/server.ts",
    "petpooja:typecheck": "tsc -p services/petpooja-bridge/tsconfig.json",
    "petpooja:test": "vitest run --config services/petpooja-bridge/vitest.config.ts",
    "petpooja:check": "npm run petpooja:typecheck && npm run petpooja:test",
    "types:generate": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
