# PetPooja bridge configuration. Copy to .env (gitignored) on the cafe machine.
# NEVER commit real values.

# The local/intranet PetPooja server base URL on the cafe machine.
# Discover the real port with `npm run petpooja:probe`. Example only:
PETPOOJA_BASE_URL=http://127.0.0.1:8965

# The intranet API base used for order/customer listing (proven at :9080).
PETPOOJA_INTRANET_URL=http://127.0.0.1:9080

# Restaurant id for the intranet order API (e.g. the proven rest_id).
PETPOOJA_REST_ID=

# Serialized authenticated PetPooja user object required by inner_order_listing.
# SECRET — never commit. Paste the exact working value on the cafe machine.
PETPOOJA_USER=

# Restaurant sync code (SECRET). Leave blank to have the probe report it as required.
PETPOOJA_SYNC_CODE=

# Optional: PetPooja server_version to send with requests. Do NOT guess.
# Determine the correct value from the running app; leave blank until known.
PETPOOJA_SERVER_VERSION=

# Bridge HTTP listener.
BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1

# Inbound auth: the cloud CRM authenticates with a key id + shared secret.
# Format: "keyId:secret" (comma-separate multiple). SECRET — keep out of git.
BRIDGE_AUTH_KEYS=crm-primary:replace-with-a-long-random-secret

# Reject requests whose timestamp is outside this window (anti-replay), ms.
BRIDGE_MAX_CLOCK_SKEW_MS=300000

# Outbound request timeout to PetPooja, ms.
PETPOOJA_TIMEOUT_MS=8000

# Log level: debug | info | warn | error
BRIDGE_LOG_LEVEL=info
